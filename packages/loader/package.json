{
  "name": "@appshell/loader",
  "version": "1.0.0-alpha.25",
  "description": "Utility for loading Appshell components",
  "main": "dist/main.js",
  "types": "dist/loader/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appshellhq/appshell.git"
  },
  "author": "Robert Hamilton <rh@navaris.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "webpack --mode production && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "start": "webpack --watch --mode development && npm run build:types",
    "stats": "webpack --json > stats.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "module federation",
    "micro-frontends",
    "appshell"
  ],
  "license": "MIT",
  "dependencies": {
    "@appshell/runtime": "^1.0.0-alpha.25",
    "@module-federation/enhanced": "^2.8.2"
  },
  "gitHead": "e8105f3c5eeb4aec8e3f0e06b151d0a0ef394d12"
}
