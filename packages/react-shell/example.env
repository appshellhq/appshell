# Dev-server and CLI settings only. Everything about how the application looks —
# root remote, title, colours, stylesheet — lives on the Application record in the
# registry, which renders the page.
APPSHELL_PORT=3030
APPSHELL_REGISTRY=/Users/robert.hamilton/workspace/oss/appshell/examples/appshell-react-host/appshell_registry
APPSHELL_API_KEY=XXX-API-KEY-FOR-BASE-REGISTRY
APPSHELL_API_KEY_HEADER=x-api-key
