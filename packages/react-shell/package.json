{
  "name": "@appshell/react-shell",
  "version": "1.0.0-alpha.6",
  "description": "Appshell shell bundle for React",
  "main": "dist/main.js",
  "repository": "https://github.com/appshell-org/appshell.git",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "run-p generate:*",
    "generate:env": "appshell generate env -e .env --prefix $APPSHELL_ENV_PREFIX",
    "generate:global-config": "appshell generate global-config --validate-registry-ssl-cert $APPSHELL_VALIDATE_REGISTRY_SSL_CERT --registry $APPSHELL_BASE_REGISTRY $APPSHELL_REGISTRY --api-key $APPSHELL_API_KEY --api-key-header $APPSHELL_API_KEY_HEADER --proxy-url $APPSHELL_PROXY_URL",
    "start": "dotenv -- run-s generate:env start:bundle",
    "start:bundle": "webpack serve --mode development",
    "prebuild": "npm run clean",
    "build": "webpack --mode production",
    "clean": "rm -rf dist"
  },
  "author": "Robert Hamilton <rh@navaris.com>",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "module federation",
    "micro-frontends",
    "appshell"
  ],
  "license": "MIT",
  "gitHead": "7ddd9f6836317732be68d1fc71b7d4e1276725a6"
}
