{
  "title": "AppshellTemplate",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the module",
      "type": "string"
    },
    "remotes": {
      "description": "Collection of remote entrypoints",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/Entrypoint"
          }
        ]
      }
    },
    "module": {
      "description": "Module federation configuration",
      "type": "object"
    },
    "vars": {
      "description": "Runtime environment configuration",
      "type": "object"
    },
    "overrides": {
      "description": "Overrides to apply",
      "type": "object",
      "properties": {
        "vars": {
          "type": "object"
        }
      }
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"],
      "description": "Visibility the registry publishes this package as; --visibility overrides it"
    }
  },
  "definitions": {
    "Entrypoint": {
      "title": "Module entrypoint",
      "type": "object",
      "properties": {
        "id": {
          "description": "ID of the remote app",
          "type": "string"
        },
        "metadata": {
          "description": "Metadata associated with the remote app",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
