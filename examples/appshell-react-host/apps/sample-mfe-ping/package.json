{
  "name": "@appshell/sample-mfe-ping",
  "version": "0.1.3",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "generate:manifest": "dotenv -- appshell generate manifest --template dist/appshell.template.json",
    "publish": "dotenv -- appshell publish --template dist/appshell.template.json",
    "watch:config": "nodemon --watch dist/appshell.template.json --exec run-s generate:manifest publish",
    "start": "dotenv -- webpack-cli serve --mode development",
    "start:run": "webpack-cli serve --mode development",
    "build": "webpack --mode production && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "serve": "dotenv -- serve dist -p $SAMPLE_MFE_PING_PORT",
    "stats": "webpack --json > stats.json"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.8.2",
    "@testing-library/react": "^16.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "@appshell/react": "^1.0.0-alpha.84",
    "@appshell/react-host-components": "*",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
