{
  "name": "appshell-react-host",
  "version": "0.0.1",
  "description": "Full example using @appshell/webpack-plugin, @appshell/cli and @appshell/react-shell to build Module Federation micro-frontends",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": "https://github.com/appshell-org/appshell.git",
  "author": "Robert Hamilton <rh@navaris.com>",
  "scripts": {
    "bootstrap": "npm install",
    "build": "dotenv -- npm run -w react-appshell-host-components build && dotenv -- npm run -w sample-mfe-container build && dotenv -- npm run -w sample-mfe-ping build && dotenv -- npm run -w sample-mfe-pong build",
    "clean": "lerna run --parallel clean && rm -rf coverage",
    "lint": "eslint 'apps/**/*.{ts,tsx}'",
    "publish": "dotenv -- lerna run --parallel publish",
    "serve": "dotenv -- lerna run --parallel serve",
    "prestart": "dotenv -- npm run -w react-appshell-host-components build",
    "start": "dotenv -- run-p start:container start:ping start:pong",
    "start:container": "dotenv -- npm run -w sample-mfe-container start",
    "start:ping": "dotenv -- npm run -w sample-mfe-ping start",
    "start:pong": "dotenv -- npm run -w sample-mfe-pong start",
    "stats": "lerna run --parallel stats",
    "test": "jest",
    "test:ci": "npm run test -- a --watchAll=false"
  },
  "dependencies": {
    "@appshell/react": "^1.0.0-alpha.36",
    "@appshell/runtime": "^1.0.0-alpha.36",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "npm-run-all": "4.1.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-refresh": "^0.14.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.5.0",
    "web-vitals": "^4.2.0",
    "webpack": "^5.106.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.0"
  },
  "devDependencies": {
    "@appshell/cli": "^1.0.0-alpha.36",
    "@appshell/webpack-plugin": "^1.0.0-alpha.36",
    "@babel/core": "^7.14.3",
    "@babel/preset-react": "^7.13.13",
    "@babel/preset-typescript": "^7.22.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-loader": "^8.2.2",
    "css-loader": "^7.1.4",
    "dotenv-cli": "7.2.1",
    "html-webpack-plugin": "^5.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-transform-stub": "^2.0.0",
    "lerna": "^9.0.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "serve": "^14.2.6",
    "single-react-refresh-plugin": "^1.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.2.0",
    "url-loader": "4.1.1",
    "webpack-visualizer-plugin2": "1.0.0"
  },
  "license": "MIT",
  "private": true
}
