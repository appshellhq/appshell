{
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "alwaysStrict": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "jsx": "react",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    // The @appshell/* packages are symlinked into this workspace. Without this,
    // TypeScript resolves their types from the parent repo's node_modules, which
    // carries a different @types/react (18.0.28) than the apps use (18.3.28) —
    // the two disagree about ReactNode, so every JSX component fails TS2786.
    "preserveSymlinks": true
  },
  "include": [
    "./apps/*/src",
    "./packages/*/src"
  ],
  "exclude": [
    "./apps/*/dist",
    "./apps/*/src/__tests__",
    "node_modules"
  ]
}
