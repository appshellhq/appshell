{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.12.0",
  "npmClient": "npm",
  "command": {
    "version": {
      "conventionalCommits": true,
      "message": "chore: release [skip ci] %s"
    }
  },
  "packages": ["packages/*"],
  "ignoreChanges": [
    "**/__fixtures__/**",
    "**/__tests__/**",
    "**/*.md",
    "**/examples/**",
    ".github/**"
  ]
}
