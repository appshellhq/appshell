{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@appshell/runtime/vars": ["./packages/runtime/src/vars"],
      "@appshell/*": ["./packages/*/src"]
    },
    "allowJs": true,
    "alwaysStrict": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "plugins": [{ "name": "@typescript-eslint" }]
  },
  "include": [
    "./packages/*/src",
    "./examples/**/src",
    "./**/__tests__",
    "./**/__fixtures__",
    "./**/__mocks__"
  ],
  "exclude": ["dist", "node_modules"]
}
